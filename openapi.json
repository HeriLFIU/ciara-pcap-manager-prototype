{
  "components": {
    "schemas": {
      "AnalysisJob": {
        "description": "The public view of a capture analysis job.",
        "properties": {
          "created_at": {
            "description": "When the upload was accepted.",
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Failure detail, present only when failed.",
            "title": "Error"
          },
          "filename": {
            "description": "Original name of the uploaded capture.",
            "title": "Filename",
            "type": "string"
          },
          "finished_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When extraction reached a terminal state.",
            "title": "Finished At"
          },
          "job_id": {
            "description": "Unique job identifier.",
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "size_bytes": {
            "description": "Size of the uploaded capture on disk.",
            "title": "Size Bytes",
            "type": "integer"
          },
          "started_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "When extraction began.",
            "title": "Started At"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus",
            "default": "pending",
            "description": "Current lifecycle state."
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FlowSummary"
              },
              {
                "type": "null"
              }
            ],
            "description": "Aggregate statistics, present once succeeded."
          }
        },
        "required": [
          "filename",
          "size_bytes"
        ],
        "title": "AnalysisJob",
        "type": "object"
      },
      "Body_upload_capture": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "description": "A libpcap or pcapng capture.",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_upload_capture",
        "type": "object"
      },
      "DecodeReport": {
        "description": "What the decoder made of every frame in a capture.",
        "properties": {
          "frames_read": {
            "description": "Frames read from the capture file.",
            "minimum": 0.0,
            "title": "Frames Read",
            "type": "integer"
          },
          "inner_packets": {
            "description": "Frames whose inner TCP/UDP packet was decoded.",
            "minimum": 0.0,
            "title": "Inner Packets",
            "type": "integer"
          },
          "packets_late": {
            "description": "Out-of-order packets that lagged by more than the reorder window and were processed out of time order.",
            "minimum": 0.0,
            "title": "Packets Late",
            "type": "integer"
          },
          "packets_out_of_order": {
            "description": "Decoded packets read with a timestamp earlier than one already read; the reorder buffer puts them back in time order.",
            "minimum": 0.0,
            "title": "Packets Out Of Order",
            "type": "integer"
          },
          "packets_over_flow_cap": {
            "description": "Decoded packets dropped because they would have opened a flow beyond the configured cap.",
            "minimum": 0.0,
            "title": "Packets Over Flow Cap",
            "type": "integer"
          },
          "packets_with_int": {
            "description": "Decoded packets that also carried an INT header.",
            "minimum": 0.0,
            "title": "Packets With Int",
            "type": "integer"
          },
          "packets_with_int_hops": {
            "description": "Decoded packets with at least one INT hop decoded.",
            "minimum": 0.0,
            "title": "Packets With Int Hops",
            "type": "integer"
          },
          "skipped": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Frames that yielded no inner packet, per reason.",
            "title": "Skipped",
            "type": "object"
          }
        },
        "required": [
          "frames_read",
          "inner_packets",
          "packets_with_int",
          "packets_with_int_hops",
          "packets_out_of_order",
          "packets_late",
          "packets_over_flow_cap"
        ],
        "title": "DecodeReport",
        "type": "object"
      },
      "Flow": {
        "description": "One flow segment built from the inner packets of INT telemetry reports.",
        "properties": {
          "ack_count_bwd": {
            "description": "ACK packets, B to A.",
            "minimum": 0.0,
            "title": "Ack Count Bwd",
            "type": "integer"
          },
          "ack_count_fwd": {
            "description": "ACK packets, A to B.",
            "minimum": 0.0,
            "title": "Ack Count Fwd",
            "type": "integer"
          },
          "ack_fraction": {
            "description": "ACK packets / `pkts_total`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Ack Fraction",
            "type": "number"
          },
          "ack_ratio_bwd": {
            "description": "`ack_count_bwd / pkts_bwd`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Ack Ratio Bwd",
            "type": "number"
          },
          "ack_ratio_fwd": {
            "description": "`ack_count_fwd / pkts_fwd`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Ack Ratio Fwd",
            "type": "number"
          },
          "base_flow_key": {
            "description": "Direction-independent identity: `proto|ip_low|ip_high|port_low|port_high`.",
            "title": "Base Flow Key",
            "type": "string"
          },
          "bwd_Bps": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "`bytes_bwd / duration`.",
            "title": "Bwd Bps"
          },
          "bwd_pps": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "`pkts_bwd / duration`.",
            "title": "Bwd Pps"
          },
          "bytes_bwd": {
            "description": "Inner IPv4 Total Length summed, B to A.",
            "minimum": 0.0,
            "title": "Bytes Bwd",
            "type": "integer"
          },
          "bytes_fwd": {
            "description": "Inner IPv4 Total Length summed, A to B.",
            "minimum": 0.0,
            "title": "Bytes Fwd",
            "type": "integer"
          },
          "bytes_per_pkt_bwd": {
            "description": "`bytes_bwd / pkts_bwd`, else 0.0.",
            "title": "Bytes Per Pkt Bwd",
            "type": "number"
          },
          "bytes_per_pkt_fwd": {
            "description": "`bytes_fwd / pkts_fwd`, else 0.0.",
            "title": "Bytes Per Pkt Fwd",
            "type": "number"
          },
          "bytes_per_pkt_gap": {
            "description": "`bytes_per_pkt_fwd - bytes_per_pkt_bwd`.",
            "title": "Bytes Per Pkt Gap",
            "type": "number"
          },
          "bytes_total": {
            "description": "`bytes_fwd + bytes_bwd`.",
            "minimum": 0.0,
            "title": "Bytes Total",
            "type": "integer"
          },
          "crosses_file_boundary": {
            "description": "1 if the segment took packets from several files.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Crosses File Boundary",
            "type": "integer"
          },
          "duration": {
            "description": "Seconds from the first to the last packet.",
            "minimum": 0.0,
            "title": "Duration",
            "type": "number"
          },
          "fin_count_bwd": {
            "description": "FIN packets, B to A.",
            "minimum": 0.0,
            "title": "Fin Count Bwd",
            "type": "integer"
          },
          "fin_count_fwd": {
            "description": "FIN packets, A to B.",
            "minimum": 0.0,
            "title": "Fin Count Fwd",
            "type": "integer"
          },
          "fin_fraction": {
            "description": "FIN packets / `pkts_total`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Fin Fraction",
            "type": "number"
          },
          "fin_ratio_bwd": {
            "description": "`fin_count_bwd / pkts_bwd`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Fin Ratio Bwd",
            "type": "number"
          },
          "fin_ratio_fwd": {
            "description": "`fin_count_fwd / pkts_fwd`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Fin Ratio Fwd",
            "type": "number"
          },
          "first_observed_dst_ip": {
            "description": "Equals `ip_b`.",
            "title": "First Observed Dst Ip",
            "type": "string"
          },
          "first_observed_dst_port": {
            "description": "Equals `port_b`.",
            "title": "First Observed Dst Port",
            "type": "integer"
          },
          "first_observed_src_ip": {
            "description": "Equals `ip_a`.",
            "title": "First Observed Src Ip",
            "type": "string"
          },
          "first_observed_src_port": {
            "description": "Equals `port_a`.",
            "title": "First Observed Src Port",
            "type": "integer"
          },
          "first_packet_ack": {
            "description": "1 if the first packet had ACK.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "First Packet Ack",
            "type": "integer"
          },
          "first_packet_direction": {
            "description": "Always `fwd`: A/B are taken from the first packet.",
            "title": "First Packet Direction",
            "type": "string"
          },
          "first_packet_syn": {
            "description": "1 if the first packet had SYN.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "First Packet Syn",
            "type": "integer"
          },
          "first_packet_was_syn": {
            "description": "1 for TCP with SYN=1 and ACK=0 on the first packet.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "First Packet Was Syn",
            "type": "integer"
          },
          "first_packet_was_syn_ack": {
            "description": "1 for TCP with SYN=1 and ACK=1 on the first packet.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "First Packet Was Syn Ack",
            "type": "integer"
          },
          "first_source_file": {
            "description": "First capture file of the segment.",
            "title": "First Source File",
            "type": "string"
          },
          "first_timeframe_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "First timeframe observed.",
            "title": "First Timeframe Id"
          },
          "flow_end_time": {
            "description": "Epoch seconds of the last packet.",
            "title": "Flow End Time",
            "type": "number"
          },
          "flow_id": {
            "description": "Segment identifier: `base_flow_key|segment`.",
            "title": "Flow Id",
            "type": "string"
          },
          "flow_initiator": {
            "description": "Always `observed_first_packet_src`.",
            "title": "Flow Initiator",
            "type": "string"
          },
          "flow_segment_id": {
            "description": "Segment counter per `base_flow_key`, starting at 0.",
            "minimum": 0.0,
            "title": "Flow Segment Id",
            "type": "integer"
          },
          "flow_start_time": {
            "description": "Epoch seconds of the first packet.",
            "title": "Flow Start Time",
            "type": "number"
          },
          "fwd_Bps": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "`bytes_fwd / duration`.",
            "title": "Fwd Bps"
          },
          "fwd_pps": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "`pkts_fwd / duration`.",
            "title": "Fwd Pps"
          },
          "fwd_share_bytes": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "`bytes_fwd / bytes_total`.",
            "title": "Fwd Share Bytes"
          },
          "fwd_share_pkts": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "`pkts_fwd / pkts_total`.",
            "title": "Fwd Share Pkts"
          },
          "iat_int_count": {
            "description": "INT-timestamp inter-arrival observations in the segment.",
            "minimum": 0.0,
            "title": "Iat Int Count",
            "type": "integer"
          },
          "iat_max_int_ns": {
            "description": "Largest INT inter-arrival (ns); 0.0 if none.",
            "title": "Iat Max Int Ns",
            "type": "number"
          },
          "iat_min_int_ns": {
            "description": "Smallest INT inter-arrival (ns); 0.0 if none.",
            "title": "Iat Min Int Ns",
            "type": "number"
          },
          "iat_std_int_ns": {
            "description": "Population std dev of INT inter-arrival (ns); 0.0 if <= 1.",
            "title": "Iat Std Int Ns",
            "type": "number"
          },
          "initiator_confidence": {
            "$ref": "#/components/schemas/InitiatorConfidence",
            "description": "`tcp_syn_noack_observed` when the first packet was a bare SYN, otherwise `observed_first_packet`."
          },
          "ip_a": {
            "description": "Source address of the segment's first packet.",
            "title": "Ip A",
            "type": "string"
          },
          "ip_b": {
            "description": "Destination address of the segment's first packet.",
            "title": "Ip B",
            "type": "string"
          },
          "last_source_file": {
            "description": "Last capture file of the segment.",
            "title": "Last Source File",
            "type": "string"
          },
          "last_timeframe_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Last timeframe observed.",
            "title": "Last Timeframe Id"
          },
          "latency_max": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Largest per-packet INT latency (ns).",
            "title": "Latency Max"
          },
          "latency_min": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Smallest per-packet INT latency (ns).",
            "title": "Latency Min"
          },
          "latency_std": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Population std dev of per-packet INT latency (ns).",
            "title": "Latency Std"
          },
          "mean_hop_count": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mean INT hops per packet, over packets carrying INT hops.",
            "title": "Mean Hop Count"
          },
          "mean_hop_latency": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mean per-packet INT latency (ns, summed over hops).",
            "title": "Mean Hop Latency"
          },
          "mean_iat_int_ns": {
            "description": "Mean INT inter-arrival (ns); 0.0 if none.",
            "title": "Mean Iat Int Ns",
            "type": "number"
          },
          "mean_pkt_size": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mean packet size in bytes.",
            "title": "Mean Pkt Size"
          },
          "pkt_size_max": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Largest packet size in bytes.",
            "title": "Pkt Size Max"
          },
          "pkt_size_min": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Smallest packet size in bytes.",
            "title": "Pkt Size Min"
          },
          "pkt_size_std": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Population std dev of sizes.",
            "title": "Pkt Size Std"
          },
          "pkts_bwd": {
            "description": "Packets from B to A.",
            "minimum": 0.0,
            "title": "Pkts Bwd",
            "type": "integer"
          },
          "pkts_fwd": {
            "description": "Packets from A to B.",
            "minimum": 0.0,
            "title": "Pkts Fwd",
            "type": "integer"
          },
          "pkts_total": {
            "description": "`pkts_fwd + pkts_bwd`.",
            "minimum": 0.0,
            "title": "Pkts Total",
            "type": "integer"
          },
          "port_a": {
            "description": "Port paired with `ip_a`.",
            "title": "Port A",
            "type": "integer"
          },
          "port_b": {
            "description": "Port paired with `ip_b`.",
            "title": "Port B",
            "type": "integer"
          },
          "proto": {
            "description": "IP protocol number: 6 for TCP, 17 for UDP.",
            "title": "Proto",
            "type": "integer"
          },
          "psh_count_bwd": {
            "description": "PSH packets, B to A.",
            "minimum": 0.0,
            "title": "Psh Count Bwd",
            "type": "integer"
          },
          "psh_count_fwd": {
            "description": "PSH packets, A to B.",
            "minimum": 0.0,
            "title": "Psh Count Fwd",
            "type": "integer"
          },
          "psh_fraction": {
            "description": "PSH packets / `pkts_total`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Psh Fraction",
            "type": "number"
          },
          "psh_ratio_bwd": {
            "description": "`psh_count_bwd / pkts_bwd`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Psh Ratio Bwd",
            "type": "number"
          },
          "psh_ratio_fwd": {
            "description": "`psh_count_fwd / pkts_fwd`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Psh Ratio Fwd",
            "type": "number"
          },
          "queue_occupancy_max": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Largest INT queue occupancy.",
            "title": "Queue Occupancy Max"
          },
          "queue_occupancy_mean": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Mean INT queue occupancy over every hop observation.",
            "title": "Queue Occupancy Mean"
          },
          "queue_occupancy_std": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Population std dev of INT queue occupancy.",
            "title": "Queue Occupancy Std"
          },
          "rst_count_bwd": {
            "description": "RST packets, B to A.",
            "minimum": 0.0,
            "title": "Rst Count Bwd",
            "type": "integer"
          },
          "rst_count_fwd": {
            "description": "RST packets, A to B.",
            "minimum": 0.0,
            "title": "Rst Count Fwd",
            "type": "integer"
          },
          "rst_fraction": {
            "description": "RST packets / `pkts_total`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Rst Fraction",
            "type": "number"
          },
          "rst_ratio_bwd": {
            "description": "`rst_count_bwd / pkts_bwd`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Rst Ratio Bwd",
            "type": "number"
          },
          "rst_ratio_fwd": {
            "description": "`rst_count_fwd / pkts_fwd`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Rst Ratio Fwd",
            "type": "number"
          },
          "small_pkt_fraction_total": {
            "description": "Share of packets of at most 100 bytes.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Small Pkt Fraction Total",
            "type": "number"
          },
          "source_file_count": {
            "description": "1 plus the number of source-file changes in the segment.",
            "minimum": 1.0,
            "title": "Source File Count",
            "type": "integer"
          },
          "syn_ack_gap": {
            "description": "`syn_count_fwd - ack_count_bwd`.",
            "title": "Syn Ack Gap",
            "type": "integer"
          },
          "syn_count_bwd": {
            "description": "SYN packets, B to A.",
            "minimum": 0.0,
            "title": "Syn Count Bwd",
            "type": "integer"
          },
          "syn_count_fwd": {
            "description": "SYN packets, A to B.",
            "minimum": 0.0,
            "title": "Syn Count Fwd",
            "type": "integer"
          },
          "syn_fraction": {
            "description": "SYN packets / `pkts_total`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Syn Fraction",
            "type": "number"
          },
          "syn_ratio_bwd": {
            "description": "`syn_count_bwd / pkts_bwd`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Syn Ratio Bwd",
            "type": "number"
          },
          "syn_ratio_fwd": {
            "description": "`syn_count_fwd / pkts_fwd`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Syn Ratio Fwd",
            "type": "number"
          },
          "termination_reason": {
            "$ref": "#/components/schemas/TerminationReason",
            "description": "Why the segment was closed."
          },
          "timeframe_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Timeframe of the segment's first packet (the capture's file name without its extension).",
            "title": "Timeframe Id"
          },
          "tiny_pkt_fraction_total": {
            "description": "Share of packets of at most 40 bytes.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Tiny Pkt Fraction Total",
            "type": "number"
          },
          "total_Bps": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "`bytes_total / duration`.",
            "title": "Total Bps"
          },
          "total_pps": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "`pkts_total / duration`.",
            "title": "Total Pps"
          },
          "truncated_ip_fraction": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Share of packets whose captured inner IPv4 bytes differ from its declared Total Length.",
            "title": "Truncated Ip Fraction"
          },
          "truncated_udp_fraction": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Share of packets whose captured inner UDP bytes differ from its declared Length.",
            "title": "Truncated Udp Fraction"
          },
          "urg_count_bwd": {
            "description": "URG packets, B to A.",
            "minimum": 0.0,
            "title": "Urg Count Bwd",
            "type": "integer"
          },
          "urg_count_fwd": {
            "description": "URG packets, A to B.",
            "minimum": 0.0,
            "title": "Urg Count Fwd",
            "type": "integer"
          },
          "urg_fraction": {
            "description": "URG packets / `pkts_total`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Urg Fraction",
            "type": "number"
          },
          "urg_ratio_bwd": {
            "description": "`urg_count_bwd / pkts_bwd`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Urg Ratio Bwd",
            "type": "number"
          },
          "urg_ratio_fwd": {
            "description": "`urg_count_fwd / pkts_fwd`.",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Urg Ratio Fwd",
            "type": "number"
          }
        },
        "required": [
          "base_flow_key",
          "flow_id",
          "flow_segment_id",
          "timeframe_id",
          "proto",
          "ip_a",
          "ip_b",
          "port_a",
          "port_b",
          "first_observed_src_ip",
          "first_observed_dst_ip",
          "first_observed_src_port",
          "first_observed_dst_port",
          "first_packet_syn",
          "first_packet_ack",
          "first_packet_was_syn",
          "first_packet_was_syn_ack",
          "first_packet_direction",
          "flow_initiator",
          "initiator_confidence",
          "pkts_fwd",
          "pkts_bwd",
          "bytes_fwd",
          "bytes_bwd",
          "pkts_total",
          "bytes_total",
          "duration",
          "flow_start_time",
          "flow_end_time",
          "termination_reason",
          "first_source_file",
          "last_source_file",
          "source_file_count",
          "first_timeframe_id",
          "last_timeframe_id",
          "crosses_file_boundary",
          "fwd_pps",
          "bwd_pps",
          "total_pps",
          "total_Bps",
          "fwd_Bps",
          "bwd_Bps",
          "mean_pkt_size",
          "pkt_size_std",
          "pkt_size_min",
          "pkt_size_max",
          "mean_hop_count",
          "mean_hop_latency",
          "iat_int_count",
          "mean_iat_int_ns",
          "iat_std_int_ns",
          "iat_min_int_ns",
          "iat_max_int_ns",
          "latency_min",
          "latency_max",
          "latency_std",
          "syn_count_fwd",
          "syn_count_bwd",
          "syn_ratio_fwd",
          "syn_ratio_bwd",
          "syn_fraction",
          "ack_count_fwd",
          "ack_count_bwd",
          "ack_ratio_fwd",
          "ack_ratio_bwd",
          "ack_fraction",
          "fin_count_fwd",
          "fin_count_bwd",
          "fin_ratio_fwd",
          "fin_ratio_bwd",
          "fin_fraction",
          "rst_count_fwd",
          "rst_count_bwd",
          "rst_ratio_fwd",
          "rst_ratio_bwd",
          "rst_fraction",
          "psh_count_fwd",
          "psh_count_bwd",
          "psh_ratio_fwd",
          "psh_ratio_bwd",
          "psh_fraction",
          "urg_count_fwd",
          "urg_count_bwd",
          "urg_ratio_fwd",
          "urg_ratio_bwd",
          "urg_fraction",
          "bytes_per_pkt_fwd",
          "bytes_per_pkt_bwd",
          "bytes_per_pkt_gap",
          "small_pkt_fraction_total",
          "tiny_pkt_fraction_total",
          "syn_ack_gap",
          "fwd_share_pkts",
          "fwd_share_bytes",
          "queue_occupancy_mean",
          "queue_occupancy_std",
          "queue_occupancy_max",
          "truncated_ip_fraction",
          "truncated_udp_fraction"
        ],
        "title": "Flow",
        "type": "object"
      },
      "FlowPage": {
        "description": "One page of flows, as returned by the flows endpoint.",
        "properties": {
          "items": {
            "description": "The flows in this page.",
            "items": {
              "$ref": "#/components/schemas/Flow"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "description": "Maximum page size that was applied.",
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "description": "Index of the first item in this page.",
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "description": "Total flows available for the capture.",
            "title": "Total",
            "type": "integer"
          }
        },
        "required": [
          "items",
          "total",
          "offset",
          "limit"
        ],
        "title": "FlowPage",
        "type": "object"
      },
      "FlowSummary": {
        "description": "Aggregate statistics describing an analysed capture.",
        "properties": {
          "byte_count": {
            "description": "Inner bytes across every flow.",
            "title": "Byte Count",
            "type": "integer"
          },
          "decode": {
            "$ref": "#/components/schemas/DecodeReport",
            "description": "How the capture's frames were decoded."
          },
          "first_seen": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Epoch seconds of the earliest flow start.",
            "title": "First Seen"
          },
          "flow_count": {
            "description": "Number of flow segments.",
            "title": "Flow Count",
            "type": "integer"
          },
          "flows_by_protocol": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Flow count per protocol name.",
            "title": "Flows By Protocol",
            "type": "object"
          },
          "flows_by_termination": {
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Flow count per termination reason.",
            "title": "Flows By Termination",
            "type": "object"
          },
          "last_seen": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Epoch seconds of the latest flow end.",
            "title": "Last Seen"
          },
          "packet_count": {
            "description": "Inner packets across every flow.",
            "title": "Packet Count",
            "type": "integer"
          }
        },
        "required": [
          "flow_count",
          "packet_count",
          "byte_count",
          "decode"
        ],
        "title": "FlowSummary",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "description": "Reports that the API is reachable.",
        "properties": {
          "service": {
            "description": "Human-readable service name.",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "description": "Always `ok` when the API is serving.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "InitiatorConfidence": {
        "description": "How much the first packet says about who opened the flow.",
        "enum": [
          "tcp_syn_noack_observed",
          "observed_first_packet",
          "unknown"
        ],
        "title": "InitiatorConfidence",
        "type": "string"
      },
      "JobStatus": {
        "description": "Lifecycle state of an analysis job.",
        "enum": [
          "pending",
          "running",
          "succeeded",
          "failed"
        ],
        "title": "JobStatus",
        "type": "string"
      },
      "TerminationReason": {
        "description": "Why a flow segment was closed.",
        "enum": [
          "inactive_timeout",
          "active_timeout",
          "tcp_rst",
          "tcp_fin_both",
          "end_of_input"
        ],
        "title": "TerminationReason",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Builds flows from the inner packets of INT telemetry captures.",
    "title": "CIARA PCAP Analysis API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/captures": {
      "get": {
        "description": "List every analysis job, newest first.\n\nArgs:\n    service: The analysis service.\n\nReturns:\n    All known jobs.",
        "operationId": "list_captures",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AnalysisJob"
                  },
                  "title": "Response List Captures",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List analysis jobs",
        "tags": [
          "captures"
        ]
      },
      "post": {
        "description": "Accept a capture upload and schedule flow extraction.\n\nArgs:\n    service: The analysis service.\n    file: The uploaded capture, streamed to disk in chunks.\n\nReturns:\n    The accepted job. Poll it to learn when extraction finished.\n\nRaises:\n    HTTPException: If the upload is too large or is not a capture file.",
        "operationId": "upload_capture",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_capture"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisJob"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upload a capture for analysis",
        "tags": [
          "captures"
        ]
      }
    },
    "/api/v1/captures/{job_id}": {
      "delete": {
        "description": "Delete the capture file backing a job, keeping the job record.\n\nArgs:\n    service: The analysis service.\n    job_id: Identifier returned by the upload endpoint.\n\nRaises:\n    HTTPException: If the job does not exist.",
        "operationId": "delete_capture",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete a stored capture file",
        "tags": [
          "captures"
        ]
      },
      "get": {
        "description": "Read the current state of an analysis job.\n\nArgs:\n    service: The analysis service.\n    job_id: Identifier returned by the upload endpoint.\n\nReturns:\n    The job, including its summary once extraction succeeded.\n\nRaises:\n    HTTPException: If the job does not exist.",
        "operationId": "read_capture",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisJob"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read one analysis job",
        "tags": [
          "captures"
        ]
      }
    },
    "/api/v1/captures/{job_id}/flows": {
      "get": {
        "description": "Read one page of the flows extracted from a capture.\n\nArgs:\n    service: The analysis service.\n    job_id: Identifier returned by the upload endpoint.\n    offset: Index of the first flow to return.\n    limit: Maximum number of flows to return.\n\nReturns:\n    The requested page of flows.\n\nRaises:\n    HTTPException: If the job does not exist.",
        "operationId": "read_capture_flows",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Job Id",
              "type": "string"
            }
          },
          {
            "description": "Index of the first flow.",
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "description": "Index of the first flow.",
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "description": "Maximum flows to return.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 100,
              "description": "Maximum flows to return.",
              "maximum": 1000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlowPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Page through extracted flows",
        "tags": [
          "captures"
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "description": "Report that the API is reachable.\n\nReturns:\n    A constant healthy payload.",
        "operationId": "read_health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    }
  }
}
